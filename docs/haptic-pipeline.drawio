<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="haptic-groundtruth" version="22.1.0">
  <diagram id="haptic-pipeline" name="Haptic pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Haptic ground-truth pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=18;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="360" y="8" width="600" height="28" as="geometry" />
        </mxCell>

        <!-- ========== 1. DETECT ========== -->
        <mxCell id="lane_d" value="1. Detect  ·  Colab / haptic_gt" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=40;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a365d;fontSize=13;swimlaneFillColor=#f5f9ff;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="400" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="video" value="Video&#xa;war_tank clip" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#333333;" vertex="1" parent="lane_d">
          <mxGeometry x="24" y="60" width="168" height="64" as="geometry" />
        </mxCell>
        <mxCell id="audio" value="Source audio&#xa;soundtrack WAV" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#333333;" vertex="1" parent="lane_d">
          <mxGeometry x="208" y="60" width="168" height="64" as="geometry" />
        </mxCell>

        <mxCell id="sed" value="Frame SED (PANNs)&#xa;~10 ms posteriors · hysteresis decode&#xa;split impulsive by posterior peaks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="lane_d">
          <mxGeometry x="40" y="160" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="refine" value="Flux refine + promote impacts&#xa;snap to earliest sharp attack&#xa;(no self-volley / no clip hardcodes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="lane_d">
          <mxGeometry x="40" y="270" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flash" value="Visual-flash align&#xa;keep unmatched audio fires&#xa;snap again (flash can lead boom)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#333333;" vertex="1" parent="lane_d">
          <mxGeometry x="40" y="380" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nms" value="NMS: one accent per blast&#xa;merge rumble + haptic gate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#6c8ebf;strokeColor=#3d5c8a;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="lane_d">
          <mxGeometry x="40" y="490" width="320" height="72" as="geometry" />
        </mxCell>

        <!-- ========== 2. PACK ========== -->
        <mxCell id="lane_p" value="2. Pack  ·  output folder" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=40;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e4d2b;fontSize=13;swimlaneFillColor=#f6fbf4;" vertex="1" parent="1">
          <mxGeometry x="440" y="44" width="380" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="events" value="events.json&#xa;start / peak / end per fire" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#82b366;strokeColor=#4a7a32;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="lane_p">
          <mxGeometry x="40" y="490" width="300" height="72" as="geometry" />
        </mxCell>
        <mxCell id="gated" value="gated_audio.wav" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="lane_p">
          <mxGeometry x="40" y="600" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="algos" value="Haptic algorithms&#xa;A perception · B frequency · C pitch&#xa;D haptic-gen · E rule-based" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="lane_p">
          <mxGeometry x="40" y="694" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="folder" value="Upload folder&#xa;events.json + algorithm_*.wav" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#333333;" vertex="1" parent="lane_p">
          <mxGeometry x="40" y="804" width="300" height="72" as="geometry" />
        </mxCell>

        <!-- ========== 3. PLAY ========== -->
        <mxCell id="lane_a" value="3. Play  ·  Android tester" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;startSize=40;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#6b4a00;fontSize=13;swimlaneFillColor=#fff8ee;" vertex="1" parent="1">
          <mxGeometry x="840" y="44" width="460" height="1000" as="geometry" />
        </mxCell>

        <mxCell id="app" value="Event-Trigger mode&#xa;shared events.json + chosen WAV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d79b00;strokeColor=#b07800;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="lane_a">
          <mxGeometry x="50" y="490" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="fire" value="Fire at peak − 70 ms&#xa;hold from start → end&#xa;stop before the next shot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="lane_a">
          <mxGeometry x="50" y="600" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="shape" value="Shape from that algorithm WAV&#xa;envelope inside the event span" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="lane_a">
          <mxGeometry x="50" y="710" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="Does the blast&#xa;hold and decline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#333333;" vertex="1" parent="lane_a">
          <mxGeometry x="130" y="810" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="spike" value="Spike&#xa;short pulse ~55 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="lane_a">
          <mxGeometry x="24" y="930" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="decay" value="Decay&#xa;solid through peak, then fade" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#333333;" vertex="1" parent="lane_a">
          <mxGeometry x="256" y="930" width="180" height="56" as="geometry" />
        </mxCell>

        <!-- Intra-detect -->
        <mxCell id="e_vid_sed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="video" target="sed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_aud_sed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="audio" target="sed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sed_refine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sed" target="refine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_refine_flash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="refine" target="flash">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_flash_nms" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="flash" target="nms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Spine: NMS → events → app  (same row) -->
        <mxCell id="e_nms_events" value="fires" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#333333;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="nms" target="events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_events_app" value="timing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#333333;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="events" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pack down -->
        <mxCell id="e_nms_gated" value="gate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.85;entryX=0;entryY=0.5;fontColor=#4a7a32;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nms" target="gated">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gated_algos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gated" target="algos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_algos_folder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="algos" target="folder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_folder_app" value="A–E WAVs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=1;fontColor=#6b4a00;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="folder" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Play down -->
        <mxCell id="e_app_fire" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="app" target="fire">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fire_shape" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fire" target="shape">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_shape_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="shape" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_spike" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;fontColor=#333333;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="decision" target="spike">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_decay" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;fontColor=#333333;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="decision" target="decay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
